from sympy import Matrix, pprint, pretty

# Define the matrix using a list of lists
M = Matrix([
    [27.6, 30.2, 162],
    [3100, 6400, 23610],
    [250, 360, 1623]
])

# Use the 
# .rref() method to row reduce
rref_matrix, pivot_columns = M.rref()

pprint(M)
print("Row Reduced Matrix:")
pprint(rref_matrix)
print("\nPivot Column Indices:")
print(pivot_columns)
